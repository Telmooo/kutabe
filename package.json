{
  "name": "kutabe",
  "displayName": "Kutabe",
  "description": "Generate documentation from templates for Python, TypeScript, and Rust",
  "private": false,
  "version": "0.1.1",
  "publisher": "telmooo",
  "repository": {
    "url": "https://github.com/Telmooo/kutabe.git",
    "type": "git"
  },
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "docstring",
    "documentation",
    "python",
    "javascript",
    "typescript",
    "rust"
  ],
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "package": "node esbuild.js --production && vsce package --no-dependencies -o './dist/kutabe.vsix'",
    "typecheck": "tsc --pretty --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "spellcheck": "cspell --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visualizer": "pnpm dlx tsx scripts/visualizer/serve.ts",
    "pretest": "tsc && node esbuild.js --copy-wasm-only",
    "test": "vscode-test",
    "postinstall": "husky",
    "release": "release-it"
  },
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:rust"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kutabe.generateDocstring",
        "title": "Kutabe: Generate Docstring"
      }
    ],
    "keybindings": [
      {
        "command": "kutabe.generateDocstring",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kutabe.generateDocstring",
          "when": "editorTextFocus && resourceLangId =~ /python|typescript|javascript|rust/",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Kutabe Configuration",
      "type": "object",
      "properties": {
        "kutabe.python.style": {
          "type": "string",
          "default": "google",
          "enum": [
            "google",
            "numpy",
            "sphinx"
          ],
          "description": "Docstring style for Python"
        },
        "kutabe.typescript.style": {
          "type": "string",
          "default": "jsdoc",
          "enum": [
            "jsdoc",
            "tsdoc"
          ],
          "description": "Docstring style for TypeScript/JavaScript"
        },
        "kutabe.rust.style": {
          "type": "string",
          "default": "rustdoc",
          "enum": [
            "rustdoc"
          ],
          "description": "Docstring style for Rust"
        }
      }
    }
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.7"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.25",
    "@cspell/dict-pt-pt": "^3.0.6",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "cspell": "^9.7.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.4",
    "markdownlint-cli2": "^0.22.0",
    "ovsx": "^0.10.9",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@10.30.3"
}
