{
  "name": "kutabe",
  "displayName": "Kutabe",
  "description": "Generate documentation from templates for Python, TypeScript, and Rust",
  "version": "0.0.1",
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "package": "node esbuild.js --production",
    "lint": "eslint src/",
    "test": "vscode-test"
  },
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:rust"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kutabe.generateDocstring",
        "title": "Kutabe: Generate Docstring"
      }
    ],
    "keybindings": [
      {
        "command": "kutabe.generateDocstring",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Kutabe Configuration",
      "type": "object",
      "properties": {
        "kutabe.python.style": {
          "type": "string",
          "default": "google",
          "enum": [
            "google",
            "numpy",
            "sphinx"
          ],
          "description": "Docstring style for Python"
        },
        "kutabe.typescript.style": {
          "type": "string",
          "default": "jsdoc",
          "enum": [
            "jsdoc",
            "tsdoc"
          ],
          "description": "Docstring style for TypeScript/JavaScript"
        },
        "kutabe.rust.style": {
          "type": "string",
          "default": "rustdoc",
          "enum": [
            "rustdoc"
          ],
          "description": "Docstring style for Rust"
        }
      }
    }
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.3",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "cspell": "^9.7.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "yarn@4.12.0"
}
