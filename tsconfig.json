{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "outDir": "out",
    "lib": ["ES2024"],
    "sourceMap": true,
    "rootDir": ".",
    "newLine": "lf"
  },
  "exclude": ["node_modules", ".vscode-test", "out"],
  "include": ["src", "tests"]
}
